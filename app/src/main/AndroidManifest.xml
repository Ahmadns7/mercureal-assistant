<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Microphone: hold-to-talk speech input. Audio never leaves the device. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
        INTERNET is for model downloads ONLY (Settings > Models, model/ModelDownloader.kt),
        fetching curated model files from Hugging Face. Nothing else in this app gets network
        access: no speech, no prompts, no transcripts, no analytics, no crash reporting.
        Do not use this permission for anything else.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Wake word: foreground service that keeps the mic open while listening, with a visible notification. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:label="Mercureal Assistant"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".wake.WakeWordService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
    </application>

</manifest>
